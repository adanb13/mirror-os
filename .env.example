# MagicMirror² display. Existing .env files are preserved during upgrade.
HOST=127.0.0.1
PORT=3000
# Background API only. Hailo has no visible component on the mirror.
API_PORT=3001
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mirror,mirror.local
TIMEZONE=America/Toronto
AI_BASE_URL=http://127.0.0.1:8000
AI_MODEL=qwen2.5-instruct:1.5b
AI_TIMEOUT_MS=120000
# Optional existing Home Assistant instance; leave blank to disable.
HA_BASE_URL=
HA_TOKEN=
HA_ENTITIES=
