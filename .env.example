# Local kiosk only by default. Linux host networking reaches existing Hailo-Ollama.
HOST=127.0.0.1
PORT=3000
# For optional LAN access, list the Pi IP/hostname used in your browser.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mirror,mirror.local
MIRROR_TITLE=Mirror
TIMEZONE=America/Toronto
MODULES=clock,notes,assistant,integrations,home-assistant
AI_BASE_URL=http://127.0.0.1:8000
AI_MODEL=qwen2.5-instruct:1.5b
AI_TIMEOUT_MS=120000
# Optional existing Home Assistant instance; leave blank to disable.
HA_BASE_URL=
HA_TOKEN=
HA_ENTITIES=
